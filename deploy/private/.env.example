# Private indexer server. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
INTERNAL_API_KEY=change-me-shared-with-gateway
PRIVATE_BIND=10.77.0.2               # WireGuard address of this server (never 0.0.0.0)
STELLAR_NETWORK=pubnet
# STELLAR_RPC_URL=                   # your own RPC node is recommended for pubnet
INDEX_FAILED_TXS=false
RETAIN_RAW_LEDGERS=20000             # ~1 day of raw facts (one partition)
RETAIN_MARKET_LEDGERS=520000         # ~30 days of trades / protocol events
# LABELS_TOKEN=                      # enable label writes (sent by editors as Bearer)
# LOGO_FETCH=false                   # no outbound HTTPS to issuer domains (SEP-1 logos); the UI keeps its bundled logos
# mTLS between gateway and API (deploy/certs/gen-certs.sh):
# TLS_CERT_FILE=/certs/api.crt
# TLS_KEY_FILE=/certs/api.key
# TLS_CLIENT_CA_FILE=/certs/ca.crt
# PG_SHARED_BUFFERS=4GB
# PG_EFFECTIVE_CACHE=12GB
