# Non-secret settings shared by fetcher, writer and api (secrets: deploy.sh).
STELLAR_NETWORK=pubnet
START_LEDGER=latest
KAFKA_BROKERS=redpanda:9092
KAFKA_RETENTION=24h
KAFKA_RETENTION_BYTES=10737418240
INDEX_FAILED_TXS=false
RETAIN_RAW_LEDGERS=20000
RETAIN_MARKET_LEDGERS=520000
RETAIN_CANDLE_LEDGERS=0
PROTOCOL_VERIFY=enforce
LOGO_FETCH=true
LOG_FORMAT=json
LOG_LEVEL=info
