DOMAIN=explorer.example.org
INTERNAL_API_KEY=change-me-shared-with-gateway       # same value as on the private server
UPSTREAM_URL=http://10.77.0.2:8080                   # private server's WireGuard IP
# mTLS (recommended): UPSTREAM_URL=https://10.77.0.2:8080 and
# UPSTREAM_CA_FILE=/certs/ca.crt
# UPSTREAM_CERT_FILE=/certs/gateway.crt
# UPSTREAM_KEY_FILE=/certs/gateway.key
# PUBLIC_API_KEYS=                                   # require API keys from public clients
# RATE_LIMIT_RPS=20
