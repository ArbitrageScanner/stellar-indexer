# Copy to .env (docker compose reads it automatically). No secrets needed:
# the indexer only reads public chain data.
STELLAR_NETWORK=testnet            # testnet | pubnet | custom (then set NETWORK_PASSPHRASE)
# STELLAR_RPC_URL=                 # default: soroban-testnet.stellar.org / mainnet.sorobanrpc.com
START_LEDGER=-1000                 # latest | oldest | -N | <sequence>; used only when no cursor exists
# END_LEDGER=0                     # stop after this ledger (0 = tail forever)
# FORCE_START=false                # ignore stored cursor
# COMMIT_EVERY=20                  # ledgers per DB transaction while backfilling
# RPC_BUFFER=                      # ledgers per getLedgers call (default 50 testnet / 10 pubnet)
# INDEX_OPERATIONS=true
# INDEX_STATE=true                 # accounts, trustlines, classic pools, offers
# INDEX_FEE_EVENTS=false           # per-tx fee token events (very high volume)
# INDEX_FAILED_TXS=true            # pubnet: ~80% of txs fail; false saves most space
# RETAIN_RAW_LEDGERS=0             # prune txs/ops/transfers/contract events older than N ledgers
# RETAIN_MARKET_LEDGERS=0          # prune trades/protocol events older than N ledgers
# RETAIN_CANDLE_LEDGERS=0          # prune ledgers + 1m candles older than N ledgers
# PRUNE_INTERVAL=5m
# HTTP_ADDR=:8080
# UI_ENABLED=true                  # explorer at /ui/ (embedded in the binary)
# UI_DIR=                          # serve the explorer from a directory instead (development)
# USD_ASSET=                       # prices XLM in USD (default: Circle USDC of the network)
# LABELS_TOKEN=                    # require Bearer token for label writes (default: open)
# LOG_LEVEL=info
