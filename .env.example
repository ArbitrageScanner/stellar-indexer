# Copy to .env (docker compose reads it). No secrets are needed to index:
# the indexer only reads public chain data.
STELLAR_NETWORK=testnet            # testnet | pubnet | custom (then set NETWORK_PASSPHRASE + STELLAR_RPC_URL)
# STELLAR_RPC_URL=                 # default: soroban-testnet.stellar.org / mainnet.sorobanrpc.com
START_LEDGER=latest                # only when nothing to resume from: latest | oldest | -N | <seq>

# --- queue (fetch/write) ---
# KAFKA_BROKERS=redpanda:9092      # required for `fetch`/`write`; unset = `run` uses the direct pipeline
# KAFKA_TOPIC=                     # default stellar.<network>.ledgers (one partition)
# KAFKA_GROUP=stellar-indexer-writer
# KAFKA_RETENTION=24h              # replay / outage buffer
# KAFKA_RETENTION_BYTES=2147483648
# KAFKA_REPLICATION=1

# --- decoding / storage ---
# COMMIT_EVERY=20                  # max ledgers per DB transaction while catching up
# INDEX_OPERATIONS=true
# INDEX_STATE=true                 # accounts, trustlines, classic pools, offers
# INDEX_FEE_EVENTS=false
# INDEX_FAILED_TXS=true            # pubnet: ~80% of txs fail; false saves most space
# PARTITION_LEDGERS=20000          # ledger range per partition (fixed at first start)
# RETAIN_RAW_LEDGERS=0             # drop txs/ops/transfers/events partitions older than N ledgers (>= PARTITION_LEDGERS)
# RETAIN_MARKET_LEDGERS=0          # trades/protocol events
# RETAIN_CANDLE_LEDGERS=0          # ledgers + 1m candles
# PRUNE_INTERVAL=5m

# --- protocol verification ---
# PROTOCOL_VERIFY=enforce          # enforce | off
# PROTOCOL_ALLOWLIST_FILE=         # JSON {"replace": false, "protocols": {"aquarius": ["<wasm hash>", ...]}}

# --- API ---
# HTTP_ADDR=:8080
# METRICS_ADDR=:9100               # fetch/write processes
# API_KEYS=                        # comma list; when set, required (X-API-Key or Bearer) except /health /ready /metrics /ui
# CORS_ORIGINS=*
# RATE_LIMIT_RPS=20                # per client IP; 0 = off
# RATE_LIMIT_BURST=40
# TRUST_PROXY=false                # honour X-Forwarded-For (only behind a trusted proxy)
# CACHE_TTL=10s                    # heavy analytics responses; 0 = off
# READY_MAX_LAG=2m                 # /ready fails when the newest ledger is older
# LABELS_TOKEN=                    # Bearer token for label writes
# LABELS_OPEN=false                # allow label writes without a token (localhost dev)
# USD_ASSET=                       # prices XLM in USD (default: Circle USDC of the network)
# UI_ENABLED=true
# LOG_LEVEL=info
# LOG_FORMAT=text                  # text | json
